# --- LLM Provider (Groq) ---
# GROQ_API_KEY=                      # required; app refuses to start without it
GROQ_BASE_URL=https://api.groq.com/openai/v1

LLM_MODEL=qwen/qwen3.8-27b
LLM_MAX_TOKENS=400
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=2
LLM_REASONING_FORMAT=hidden
LLM_REASONING_EFFORT=none

AGENT_MAX_STEPS=5
AGENT_GRAPH_RECURSION_LIMIT=10

RAG_TOP_K=3

# --- Embeddings (Hugging Face Inference API) ---
# HF_TOKEN=                       # required; no local model downloads
# HF_EMBEDDINGS_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384

# --- Vector store (Qdrant) ---
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=documents

# --- SQLite databases ---
# JOBS_DB_PATH=data/jobs.db
# KEYS_DB_PATH=data/keys.db
# METADATA_DB_PATH=data/app.db
# MODELS_DB_PATH=data/models.db

# --- Jobs / worker ---
# JOB_MAX_ATTEMPTS=3
# JOB_HEARTBEAT_TIMEOUT_SECONDS=300

# --- Auth / rate limiting ---
# RATE_LIMIT_MAX_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60
# "memory" is per-process (single uvicorn worker); "redis" shares across workers.
# RATE_LIMIT_STRATEGY=memory
# REDIS_URL=redis://localhost:6379

# --- Logging ---
# LOG_LEVEL=INFO

# --- Observability ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACING_ENABLED=true

# --- Demo endpoints (/slow-sync, /slow-async, /slow-blocked) ---
# DEMO_ENDPOINTS=false

# --- Eval (tools/run_eval.py) ---
# EVAL_JUDGE_MODEL=openai/gpt-oss-120b
# Judge models accept only low/medium/high for reasoning_effort (unlike qwen's none).
# EVAL_JUDGE_REASONING_EFFORT=low